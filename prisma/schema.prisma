generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  super_admin
  manager
  team_member
}

enum HealthStatus {
  healthy
  at_risk
  critical
}

enum ProjectStatus {
  active
  paused
  completed
  archived
}

enum Priority {
  urgent
  high
  normal
  low
}

enum NotificationType {
  task_assigned
  status_changed
  comment_added
  deadline_approaching
  approval_required
}

enum EntityType {
  client
  project
  task
}

enum RecurrenceFrequency {
  daily
  weekly
  monthly
}

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  password          String
  role              Role     @default(team_member)
  avatarUrl         String?
  preferredLanguage String   @default("en")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  assignedTasks  Task[]         @relation("AssignedTasks")
  createdTasks   Task[]         @relation("CreatedTasks")
  createdClients Client[]
  createdProjects Project[]
  comments       Comment[]
  timeLogs       TimeLog[]
  notifications  Notification[]
  activityLogs   ActivityLog[]
  invitations    Invitation[]   @relation("InvitedBy")
  accounts       Account[]
  sessions       Session[]
}

model Invitation {
  id          String    @id @default(cuid())
  email       String
  token       String    @unique
  role        Role      @default(team_member)
  invitedById String
  invitedBy   User      @relation("InvitedBy", fields: [invitedById], references: [id])
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
}

model Client {
  id             String       @id @default(cuid())
  name           String
  industry       String?
  logoUrl        String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  retainerType   String?
  contractStart  DateTime?
  contractEnd    DateTime?
  driveFolderUrl String?
  brandKitUrl    String?
  websiteUrl     String?
  internalNotes  String?
  healthStatus   HealthStatus @default(healthy)
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  projects     Project[]
  activityLogs ActivityLog[]
}

model ServiceType {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String
  iconName  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pipelineTemplate PipelineTemplate?
  bundleTemplate   BundleTemplate?
  projects         Project[]
  tasks            Task[]
}

model PipelineTemplate {
  id            String      @id @default(cuid())
  serviceTypeId String      @unique
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  stages        Json
  updatedById   String
  updatedAt     DateTime    @updatedAt
}

model BundleTemplate {
  id            String      @id @default(cuid())
  serviceTypeId String      @unique
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id])
  tasks         Json
  updatedById   String
  updatedAt     DateTime    @updatedAt
}

model Project {
  id               String        @id @default(cuid())
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id])
  serviceTypeId    String
  serviceType      ServiceType   @relation(fields: [serviceTypeId], references: [id])
  name             String
  description      String?
  status           ProjectStatus @default(active)
  startDate        DateTime?
  endDate          DateTime?
  pipelineSnapshot Json
  createdById      String
  createdBy        User          @relation(fields: [createdById], references: [id])
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  tasks        Task[]
  activityLogs ActivityLog[]
}

model Task {
  id             String      @id @default(cuid())
  projectId      String
  project        Project     @relation(fields: [projectId], references: [id])
  serviceTypeId  String
  serviceType    ServiceType @relation(fields: [serviceTypeId], references: [id])
  title          String
  description    String?
  status         String
  priority       Priority    @default(normal)
  assignedToId   String?
  assignedTo     User?       @relation("AssignedTasks", fields: [assignedToId], references: [id])
  dueDate        DateTime?
  estimatedHours Decimal?
  actualHours    Decimal?    @default(0)
  tags           String[]
  isRecurring    Boolean     @default(false)
  recurrenceRule Json?
  parentTaskId   String?
  createdById    String
  createdBy      User        @relation("CreatedTasks", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  comments     Comment[]
  attachments  Attachment[]
  timeLogs     TimeLog[]
  notifications Notification[]
  activityLogs ActivityLog[]
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  content   String
  isEdited  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attachment {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploaderId String
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  createdAt  DateTime @default(now())
}

model TimeLog {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  hours      Decimal
  note       String?
  loggedDate DateTime @default(now())
  createdAt  DateTime @default(now())
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id])
  type        NotificationType
  taskId      String?
  task        Task?            @relation(fields: [taskId], references: [id])
  payload     Json
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())
}

model ActivityLog {
  id         String     @id @default(cuid())
  entityType EntityType
  entityId   String
  clientId   String?
  client     Client?    @relation(fields: [clientId], references: [id])
  projectId  String?
  project    Project?   @relation(fields: [projectId], references: [id])
  taskId     String?
  task       Task?      @relation(fields: [taskId], references: [id])
  actorId    String
  actor      User       @relation(fields: [actorId], references: [id])
  action     String
  diff       Json?
  createdAt  DateTime   @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}